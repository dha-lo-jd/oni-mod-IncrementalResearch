msgctxt "IncrementalResearch.STRINGS.UI.TITLE"
msgid "Incremental Research"
msgstr "インクリメンタル研究"

msgctxt "IncrementalResearch.STRINGS.UI.ARCHIVE.SIDESCREEN_TITLE"
msgid "Record Archive"
msgstr "記録保管庫"

msgctxt "IncrementalResearch.STRINGS.UI.ARCHIVE.UNIT"
msgid "Holdings"
msgstr "収蔵量"

msgctxt "IncrementalResearch.STRINGS.UI.ARCHIVE.EXPAND_BUTTON"
msgid "Expand to increase {0} ({1} Insight)"
msgstr "設備を拡張して{0}を増やす(知見 {1})"

msgctxt "IncrementalResearch.STRINGS.UI.ARCHIVE.STATUS_TOOLTIP"
msgid ""
"Insight: {0}\n"
"Base rate: {1}/s\n"
"{3}: {2}\n"
"Production: {4}/s"
msgstr ""
"知見: {0}\n"
"基礎速度: {1}/秒\n"
"{3}: {2}\n"
"生産量: {4}/秒"

msgctxt "IncrementalResearch.STRINGS.BUILDINGS.PREFABS.IR_RECORDARCHIVE.NAME"
msgid "Record Archive"
msgstr "記録保管庫"

msgctxt "IncrementalResearch.STRINGS.BUILDINGS.PREFABS.IR_RECORDARCHIVE.DESC"
msgid "Stores the colony's research records."
msgstr "コロニーの研究記録を保管します。"

msgctxt "IncrementalResearch.STRINGS.BUILDINGS.PREFABS.IR_RECORDARCHIVE.EFFECT"
msgid ""
"Generates Insight from the colony's research output while powered.\n"
"\n"
"Keeps research buildings running after all research is complete."
msgstr ""
"電力が供給されている間、コロニーの研究成果から知見を生み出します。\n"
"\n"
"すべての研究が完了した後も、研究設備を稼働させ続けます。"

msgctxt "IncrementalResearch.STRINGS.UI.TAB.OPEN"
msgid "Insight"
msgstr "知見"

msgctxt "IncrementalResearch.STRINGS.UI.TAB.CLOSE"
msgid "Research Tree"
msgstr "研究ツリー"

msgctxt "IncrementalResearch.STRINGS.UI.TAB.TITLE"
msgid "Insight"
msgstr "知見"

msgctxt "IncrementalResearch.STRINGS.UI.TAB.INSIGHT"
msgid "Insight: {0}"
msgstr "知見: {0}"

msgctxt "IncrementalResearch.STRINGS.UI.TAB.BASE_RATE"
msgid "Base rate: {0}/s"
msgstr "基礎速度: {0}/秒"

msgctxt "IncrementalResearch.STRINGS.UI.TAB.STATUS_ACTIVE"
msgid "Record Archive is running. Research buildings keep working after all research is complete."
msgstr "記録保管庫が稼働中です。すべての研究が完了した後も、研究設備は稼働し続けます。"

msgctxt "IncrementalResearch.STRINGS.UI.TAB.STATUS_INACTIVE"
msgid "No powered Record Archive. Insight is not being produced."
msgstr "電力が供給された記録保管庫がありません。知見は生産されていません。"

