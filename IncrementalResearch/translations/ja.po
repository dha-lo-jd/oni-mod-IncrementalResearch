msgid "Insight research in progress"
msgstr "知見の研究中"

msgctxt "IncrementalResearch.STRINGS.UI.SIDE.OPEN_BUTTON"
msgid "Insight Research"
msgstr "知見の研究"

msgctxt "IncrementalResearch.STRINGS.UI.HUD.TEXT"
